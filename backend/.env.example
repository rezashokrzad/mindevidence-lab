# Copy to backend/.env (git-ignored) and fill in. Never commit real credentials.
# This file must stay free of real secrets (a test checks it).

# ---------------------------------------------------------------- database
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://mindevidence:CHANGE_ME@localhost:5432/mindevidence
# Disposable test database. The test suite DROPS and recreates all tables here.
# Its name must end in "_test".
TEST_DATABASE_URL=postgresql+psycopg://mindevidence:CHANGE_ME@localhost:5432/mindevidence_test

# ---------------------------------------------------------------- app
# development | test | production
APP_ENV=development
# Exact frontend origins (CORS + CSRF Origin check), comma-separated. No wildcards.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Where the browser lands after sign-in when no valid return_to is given. Must be on CORS_ORIGINS.
FRONTEND_URL=http://localhost:5173/

# ---------------------------------------------------------------- Google sign-in
# From Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# See docs/google-oauth-setup.md. The secret is used ONLY by the backend.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" of the OAuth client.
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/callback

# ---------------------------------------------------------------- sessions
# At least 32 random characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs everyone out.
SESSION_SECRET=
SESSION_TTL_HOURS=12
# true = cookies only over HTTPS (required in production; cookie becomes __Host-me_session).
COOKIE_SECURE=false

# ---------------------------------------------------------------- who may sign in
# Leave both empty to allow any Google account with a verified email (fine for local testing).
# For a class, restrict to your institution's domain and/or explicit addresses.
ALLOWED_EMAIL_DOMAINS=
ALLOWED_EMAILS=
# Google subject ids ("sub") that get the instructor role. Find them after first sign-in with:
#   SELECT google_sub, email FROM auth.users;   (see docs/google-oauth-setup.md)
INSTRUCTOR_GOOGLE_SUBS=

DB_POOL_SIZE=5

# ---------------------------------------------------------------- document ingestion
# Relative paths are resolved from the repository root.
CORPUS_SOURCE_DIR=data/papers
CORPUS_MANIFEST=data/corpus_manifest.json
DOCUMENT_STORAGE_DIR=backend/storage/documents
# Chunk sizes in estimated tokens (words + punctuation). Changing them re-chunks on the next run.
CHUNK_TARGET_TOKENS=550
CHUNK_MIN_TOKENS=400
CHUNK_MAX_TOKENS=700
CHUNK_OVERLAP_TOKENS=80

# ---------------------------------------------------------------- semantic retrieval (Batch 06)
# sentence-transformers (needs requirements-embeddings.txt) or hash (non-semantic test embedder only).
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# Hugging Face commit hash to pin for a reproducible index (empty = whatever is downloaded; recorded as the version).
EMBEDDING_MODEL_REVISION=
# Fixed by the database column vector(384); a different value is refused.
EMBEDDING_DIMENSION=384
# Load the model at startup in a background thread (first question is fast; startup uses more memory).
EMBEDDING_PRELOAD=true
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_RETRIES=3
EMBEDDING_RETRY_BACKOFF_SECONDS=1.0
EMBEDDING_WINDOW_WORDS=150
EMBEDDING_WINDOW_OVERLAP_WORDS=30
RETRIEVAL_DEFAULT_TOP_K=5
RETRIEVAL_MAX_TOP_K=20
# Optional noise cut-off on cosine similarity (empty = none). Not a correctness threshold.
RETRIEVAL_DEFAULT_MIN_SIMILARITY=

# ---------------------------------------------------------------- DeepSeek (used from Batch 07, backend only)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Reasoning ("thinking") mode is off: it adds latency and the answers are schema-constrained JSON.
DEEPSEEK_THINKING=disabled
DEEPSEEK_TEMPERATURE=0.2
DEEPSEEK_MAX_OUTPUT_TOKENS=1800
DEEPSEEK_CONNECT_TIMEOUT_SECONDS=5
DEEPSEEK_READ_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_RETRY_BACKOFF_SECONDS=1.0
# Cap on search-tool calls the model may make in auto mode, and on JSON repair attempts.
LLM_MAX_TOOL_CALLS=2
LLM_MAX_REPAIR_ATTEMPTS=1

# ---------------------------------------------------------------- optional Gmail summaries (Batch 09)
# Leave EMAIL_TOKEN_ENCRYPTION_KEY empty to keep the feature off. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EMAIL_TOKEN_ENCRYPTION_KEY=
GMAIL_REDIRECT_URI=http://localhost:8000/api/reports/email/callback
REPORT_MIN_INTERVAL_SECONDS=300
REPORT_MAX_PER_DAY=3
REPORT_PERIOD_DAYS=7
